includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database
    level: 5
    excludePaths:
        - app/Filament
        - vendor

    # Laravel models type cast attributes through PHPDoc, so PHPStan reads
    # `$user->status` as `string` while `casts()` makes it a UserStatus enum at
    # runtime. Treating those PHPDoc types as certain reports every enum
    # comparison as an impossible condition. This is PHPStan's own recommended
    # setting for that situation (it is printed in the error tips).
    treatPhpDocTypesAsCertain: false

    # A baseline entry whose error no longer occurs fails the analysis, so a
    # fixed finding cannot linger as a silent suppression. This is what keeps
    # the suppressed set honest — see phpstan-baseline.neon for the entry
    # format the gate requires.
    reportUnmatchedIgnoredErrors: true
