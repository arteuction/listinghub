APP_NAME=ListingHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# The only authoritative install marker is storage/app/installed.lock.
# (There is deliberately no INSTALLED flag.)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listinghub
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- OAuth (optional; leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Payments (optional per gateway) ---
PAYMENTS_DEFAULT=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- License check (optional; HTTPS only, key from env — no hardcoded secrets) ---
LICENSE_VERIFY_ENABLED=false
LICENSE_API_URL=https://
LICENSE_API_KEY=

# --- Interactive map (3.4.1) ---
# Raster tile URL (fine for dev). For production use a hosted provider — OSM
# tiles have no SLA and may throttle heavy traffic.
# MapTiler example: https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Max features returned by /api/catalog/map (clamped to 5000 server-side).
MAP_MAX_FEATURES=1000
