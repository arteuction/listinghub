/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/app/installed.lock
/storage/pail
/vendor

# Runtime artefacts written by artisan/Pest/Deptrac. The .gitkeep files that
# hold these directories in the repo stay tracked; everything the framework
# generates inside them does not. Without these rules a local `verify.sh` run
# leaves hundreds of untracked session and compiled-view files behind, which a
# `git add -A` would happily commit.
/bootstrap/cache/*.php
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/.deptrac.cache
.env
.env.backup
.env.production
.phpactor.json
auth.json
composer.phar
yarn.lock
/.fleet
/.idea
/.vscode
.DS_Store

# The BG geo dataset IS committed: it is official NSI EKATTE data, freely
# usable with attribution, and the platform is unusable without it.
# CodeCanyon reference archives must NEVER enter the repo
*.zip

# Playwright artefacts
/storage/playwright
/storage/playwright-report
/test-results
/storage/lighthouse
/.lighthouseci
